# Educator Connect — public_html/.htaccess
# React SPA (index.html) and Laravel API (index.php) served from one domain.

DirectoryIndex index.html index.php

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass auth headers through to PHP (some cPanel/FastCGI setups strip them).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Force HTTPS (secure session cookies require it).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Never serve dotfiles (.env…) or the Laravel code folder.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^educator-connect-backend(/|$) - [F,L]

    # Backend routes go to Laravel.
    RewriteRule ^(api|sanctum|oauth|up)(/.*)?$ index.php [L]

    # Real files and folders (assets/, logo, storage/ uploads) are served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Missing uploads → Laravel 404 instead of the React page.
    RewriteRule ^storage/ index.php [L]

    # Everything else is a React Router page.
    RewriteRule ^ index.html [L]
</IfModule>

# The SPA shell must never be cached, or users keep loading old asset hashes.
<IfModule mod_headers.c>
    # cPanel's NGINX proxy cache ignores Cache-Control; X-Accel-Expires tells it not
    # to store responses (API data is per user and must never be shared).
    Header always set X-Accel-Expires "0"

    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    # Vite fingerprints JS/CSS file names, so they can be cached forever.
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php85” package as the default “PHP” programming language.
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler
